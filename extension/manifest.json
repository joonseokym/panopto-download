{
  "manifest_version": 3,
  "name": "Panopto 다운로드 · 배속",
  "version": "1.1.0",
  "description": "로그인한 Panopto 영상과 폴더를 브라우저에서 다운로드하고 재생 속도를 조절합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://*.panopto.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Panopto 다운로드",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.panopto.com/Panopto/Pages/Viewer.aspx*",
        "https://*.panopto.com/Panopto/Pages/Embed.aspx*",
        "https://*.panopto.com/Panopto/Pages/Sessions/List.aspx*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
