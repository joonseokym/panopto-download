{
  "manifest_version": 3,
  "name": "Panopto 다운로드 · 배속 (도우미 포함)",
  "version": "1.2.0",
  "description": "로컬 도우미로 Panopto 영상과 폴더를 저장하고 재생 속도를 조절합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*.panopto.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Panopto 다운로드",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.panopto.com/Panopto/Pages/Viewer.aspx*",
        "https://*.panopto.com/Panopto/Pages/Embed.aspx*",
        "https://*.panopto.com/Panopto/Pages/Sessions/List.aspx*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
